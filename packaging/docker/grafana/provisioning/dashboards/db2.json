{
  "title": "IBM DB2 — Metrics & Query Samples",
  "uid": "db2-metrics",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "db2_db2_connection_count", "legendFormat": "Connections", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 2,
      "title": "Deadlocks",
      "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "increase(db2_db2_deadlock_count_total[5m])", "legendFormat": "Deadlocks", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 3,
      "title": "Lock Waits",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "increase(db2_db2_lock_wait_count_total[5m])", "legendFormat": "Lock Waits", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 9,
      "title": "Lock Timeouts",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "increase(db2_db2_lock_timeout_count_total[5m])", "legendFormat": "Timeouts", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 10,
      "title": "Lock Wait Time (s)",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "rate(db2_db2_lock_wait_time_total[5m])", "legendFormat": "s/s", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 4,
      "title": "Buffer Pool Hit Ratio %",
      "type": "gauge",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "100 * (1 - sum by (db_namespace) (rate(db2_db2_buffer_pool_physical_reads_total[5m])) / sum by (db_namespace) (rate(db2_db2_buffer_pool_logical_reads_total[5m])))",
        "legendFormat": "{{db_namespace}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent"}}
    },
    {
      "id": 5,
      "title": "Active Connections Over Time",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 8, "h": 8},
      "targets": [{"expr": "db2_db2_connection_count", "legendFormat": "{{db_namespace}}", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 6,
      "title": "Buffer Pool Hit Ratio Over Time",
      "type": "timeseries",
      "gridPos": {"x": 8, "y": 4, "w": 8, "h": 8},
      "targets": [{
        "expr": "100 * (1 - sum by (db_namespace) (rate(db2_db2_buffer_pool_physical_reads_total[5m])) / sum by (db_namespace) (rate(db2_db2_buffer_pool_logical_reads_total[5m])))",
        "legendFormat": "{{db_namespace}}",
        "datasource": {"type": "prometheus", "uid": "prometheus"}
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 11,
      "title": "Buffer Pool Physical Reads Over Time",
      "type": "timeseries",
      "gridPos": {"x": 16, "y": 4, "w": 8, "h": 8},
      "targets": [{"expr": "rate(db2_db2_buffer_pool_physical_reads_total[5m])", "legendFormat": "{{db_namespace}} — {{db2_bufferpool}}", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 7,
      "title": "Tablespace Usage (bytes)",
      "type": "bargauge",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "targets": [
        {"expr": "db2_db2_tablespace_size{db2_tablespace_usage=\"used\"}", "legendFormat": "Used — {{db2_tablespace}}", "datasource": {"type": "prometheus", "uid": "prometheus"}},
        {"expr": "db2_db2_tablespace_size{db2_tablespace_usage=\"free\"}", "legendFormat": "Free — {{db2_tablespace}}", "datasource": {"type": "prometheus", "uid": "prometheus"}}
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 8,
      "title": "Lock Wait Time Over Time",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "targets": [{"expr": "rate(db2_db2_lock_wait_time_total[5m])", "legendFormat": "{{db_namespace}}", "datasource": {"type": "prometheus", "uid": "prometheus"}}],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 12,
      "title": "Top Queries (by avg elapsed time)",
      "type": "logs",
      "gridPos": {"x": 0, "y": 18, "w": 24, "h": 10},
      "targets": [
        {
          "expr": "{service_name=\"splunk-otel-db2\"} | json | event_name=\"db.server.top_query\"",
          "legendFormat": "",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {"showLabels": true, "showTime": true, "wrapLogMessage": true}
    },
    {
      "id": 13,
      "title": "Query Samples (currently executing)",
      "type": "logs",
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 10},
      "targets": [
        {
          "expr": "{service_name=\"splunk-otel-db2\"} | json | event_name=\"db.server.query_sample\"",
          "legendFormat": "",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {"showLabels": true, "showTime": true, "wrapLogMessage": true}
    }
  ],
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "30s"
}
