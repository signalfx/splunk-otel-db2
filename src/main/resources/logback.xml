<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="com.splunk.otel.db2" level="DEBUG"/>
    <!-- Surface gRPC channel state changes and OTLP export failures -->
    <logger name="io.grpc" level="WARN"/>
    <logger name="io.opentelemetry.exporter" level="WARN"/>
</configuration>
