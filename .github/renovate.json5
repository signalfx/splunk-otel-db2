{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "matchPackagePrefixes": ["com.diffplug.spotless"],
      "groupName": "spotless packages"
    },
    {
      "matchPackagePrefixes": ["com.gradleup.shadow"],
      "groupName": "gradle shadow packages"
    }
  ]
}
